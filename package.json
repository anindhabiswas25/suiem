{
  "name": "suiem",
  "private": true,
  "description": "Suiem: AI-powered social investing and research network (Robinhood Chain testnet only).",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && turbo run dev --filter=@suiem/api --filter=@suiem/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps packages workers --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @suiem/web test:e2e",
    "db:migrate": "node scripts/ensure-env.mjs && pnpm --filter @suiem/db migrate",
    "db:seed": "node scripts/ensure-env.mjs && pnpm --filter @suiem/db seed",
    "contracts:build": "pnpm contracts:deps && cd packages/contracts && forge build",
    "check:secrets": "docker run --rm -v \"$PWD:/repo\" -w /repo zricethezav/gitleaks:v8.30.0 detect --source /repo --config /repo/.gitleaks.toml --redact --no-banner",
    "check:secrets:staged": "docker run --rm -v \"$PWD:/repo\" -w /repo zricethezav/gitleaks:v8.30.0 detect --source /repo --config /repo/.gitleaks.toml --redact --no-banner --no-git",
    "check:vulns": "pnpm audit --audit-level high && docker run --rm -v \"$PWD:/src\" -w /src ghcr.io/google/osv-scanner:v2.3.2 scan source --lockfile=/src/pnpm-lock.yaml",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise && pnpm test && pnpm test:integration && pnpm contracts:build",
    "env:example": "tsx scripts/gen-env-example.ts",
    "env:init": "node scripts/ensure-env.mjs",
    "test:e2e:extension": "pnpm --filter @suiem/extension test:e2e",
    "extension:build": "pnpm --filter @suiem/extension build",
    "extension:zip": "pnpm --filter @suiem/extension zip",
    "research:smoke": "pnpm --filter @suiem/research smoke",
    "contracts:deps": "cd packages/contracts && ([ -d lib/openzeppelin-contracts ] || forge install OpenZeppelin/openzeppelin-contracts@v5.6.1 --no-git) && ([ -d lib/forge-std ] || forge install foundry-rs/forge-std@v1.16.2 --no-git)",
    "contracts:test": "pnpm contracts:deps && cd packages/contracts && forge test",
    "contracts:deploy:testnet": "tsx --env-file=.env scripts/deploy-testnet.ts --verify",
    "contracts:abis": "tsx scripts/gen-abis.ts",
    "invest:smoke": "tsx --env-file=.env scripts/invest-smoke.ts",
    "user:role": "node scripts/ensure-env.mjs && pnpm --filter @suiem/db user:role",
    "contracts:test:fork": "pnpm contracts:deps && cd packages/contracts && bash -c \"set -a && . ../../.env && set +a && forge test --match-path 'test/fork/*' -vv\"",
    "contracts:deploy:mainnet": "tsx --env-file=.env scripts/deploy-mainnet.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@suiem/chain": "workspace:*",
    "@suiem/config": "workspace:*",
    "@suiem/db": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "viem": "2.57.17",
    "vitest": "5.1.0"
  }
}
