# Suiem environment variables. Copy to .env (git-ignored) and fill in locally.
# NAMES and DESCRIPTIONS only, never values (PRD §0.2 rule 10). Checked by packages/config/src/env.test.ts.

# Runtime mode: development | test | production.
NODE_ENV=

# Port the API listens on (default 4000).
API_PORT=

# Exact origin of the web app, e.g. http://localhost:3000. Used for CSRF Origin checks, WebAuthn and SIWE domain binding.
WEB_ORIGIN=

# Base URL the web app proxies /api/* to (server-side only).
API_URL=

# Postgres URL used by the API (single application role in the hackathon build, ADR-0010 §5).
DATABASE_URL=

# Redis URL for rate limits, WebAuthn challenges and SIWE nonces.
REDIS_URL=

# 32+ byte random secret used to HMAC session tokens.
SESSION_SECRET=

# true|false: set the Secure flag on cookies.
COOKIE_SECURE=

# WebAuthn relying-party ID (hostname of WEB_ORIGIN, e.g. localhost).
WEBAUTHN_RP_ID=

# WebAuthn relying-party display name.
WEBAUTHN_RP_NAME=

# Optional RPC override for Robinhood Chain mainnet 4663 (default: verified public RPC).
MAINNET_RPC_URL=

# Optional RPC override for Robinhood Chain testnet 46630 (default: verified public RPC).
TESTNET_RPC_URL=

# Optional. Enables Alchemy as primary RPC with public fallback on both networks.
ALCHEMY_API_KEY=

# Pino log level (info by default).
LOG_LEVEL=

# true|false: disables Redis rate limiting. Test-only; refused in production.
RATE_LIMIT_DISABLED=

# Env override for the trading.testnet flag (true|false).
FLAG_TRADING_TESTNET=

# Env override for the elections flag (true|false).
FLAG_ELECTIONS=

# Env override for the campaigns flag (true|false).
FLAG_CAMPAIGNS=
