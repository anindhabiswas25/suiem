# Suiem environment variables. Copy to .env (git-ignored) and fill in locally.
# This file must contain NAMES and DESCRIPTIONS only, never values (PRD §0.2 rule 10).
# Checked by packages/config/src/env.test.ts.

# Runtime mode: development | test | production. Production refuses single-maintainer mode.
NODE_ENV=

# Port the API listens on (default 4000).
API_PORT=

# Exact origin of the web app, e.g. http://localhost:3000. Used for CORS, CSRF Origin checks, WebAuthn and SIWE domain binding.
WEB_ORIGIN=

# Base URL the web app proxies /api/* to (server-side only).
API_URL=

# Postgres URL for the RLS-enforced application role (suiem_app).
DATABASE_URL=

# Postgres URL for the RLS-bypassing system role (suiem_system), used only by privileged modules.
DATABASE_SYSTEM_URL=

# Postgres URL for the schema owner (migrations and seed only).
DATABASE_OWNER_URL=

# Redis URL for rate limits, WebAuthn challenges and OTP attempt counters.
REDIS_URL=

# 32+ byte random secret used to HMAC session tokens and OTP codes.
SESSION_SECRET=

# true|false: set the Secure flag on cookies (true everywhere except non-localhost http).
COOKIE_SECURE=

# WebAuthn relying-party ID (hostname of WEB_ORIGIN, e.g. localhost).
WEBAUTHN_RP_ID=

# WebAuthn relying-party display name.
WEBAUTHN_RP_NAME=

# SMTP host for the EmailProvider (Mailpit locally).
SMTP_HOST=

# SMTP port (Mailpit: 1025).
SMTP_PORT=

# From address for transactional email.
EMAIL_FROM=

# Override RPC URL. Defaults to the verified public testnet RPC. The chainId must be 46630 or boot fails.
CHAIN_RPC_URL=

# Optional. Enables the Alchemy testnet RPC as primary with public fallback (ADR-0002).
ALCHEMY_API_KEY=

# Optional OTLP/HTTP collector endpoint, e.g. http://localhost:4318. Unset disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name reported to OpenTelemetry.
OTEL_SERVICE_NAME=

# Pino log level (info by default).
LOG_LEVEL=

# true|false: acknowledges a single human operating both seeded admins (ADR-0010). Forbidden in production.
ADMIN_SINGLE_MAINTAINER_MODE=

# true|false: disables Redis rate limiting. Test-only; refused in production.
RATE_LIMIT_DISABLED=
